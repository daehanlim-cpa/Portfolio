# Environment Variables Template

# --- AI chat: Ollama (see SETUP_OLLAMA.md) ---
# Where Ollama is reachable. Default: http://127.0.0.1:11434 (same machine).
# OLLAMA_BASE_URL=https://ollama.daehanlim.com
# Cloudflare Access service token, when Ollama sits behind a Cloudflare Tunnel.
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=
# Or a bearer token for your own reverse proxy.
# OLLAMA_API_KEY=

# --- Required in production: durable rate limiting ---
# Free tier at https://console.upstash.com (create a Redis database, copy the
# REST credentials). Without these the app falls back to in-memory limits, which
# reset on every cold start and do NOT protect the model server from load.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional tuning ---
# Hard site-wide daily ceiling on chat messages. Past this the chat shows an
# "at capacity" state instead of calling the API. Default: 500
# CHAT_DAILY_GLOBAL_LIMIT=500

# Topic-gate overrides (0-1). By default the values measured by
# `npm run build:embeddings` and stored in data/embeddings.json are used.
# CHAT_TOPIC_THRESHOLD=
# CHAT_TOPIC_FLOOR=

# Model tags (defaults shown). Changing the embedding model requires
# `npm run build:embeddings`.
# RESUME_CHAT_MODEL=qwen2.5:7b
# RESUME_EMBEDDING_MODEL=nomic-embed-text

# Ollama tuning (defaults shown)
# OLLAMA_NUM_CTX=16384
# OLLAMA_KEEP_ALIVE=30m
# OLLAMA_TIMEOUT_MS=45000
# OLLAMA_THINK=false

# Used for the API origin check. Set to your production URL.
# NEXT_PUBLIC_SITE_URL=https://daehanlim.com
