# Environment Variables Template

# --- Required: AI chat ---
# Claude API key from https://platform.claude.com (Settings -> API keys).
# Set a monthly spend limit under Settings -> Billing to cap costs.
ANTHROPIC_API_KEY=

# --- Required in production: durable rate limiting ---
# Free tier at https://console.upstash.com (create a Redis database, copy the
# REST credentials). Without these the app falls back to in-memory limits, which
# reset on every cold start and do NOT protect your API spend.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional tuning ---
# Hard site-wide daily ceiling on chat messages. Past this the chat shows an
# "at capacity" state instead of calling the API. Default: 500
# CHAT_DAILY_GLOBAL_LIMIT=500

# Claude model for the assistant. Default: claude-haiku-4-5 (cheapest).
# e.g. claude-sonnet-5 or claude-opus-5 for stronger answers at higher cost.
# RESUME_CHAT_MODEL=claude-haiku-4-5

# Used for the API origin check. Set to your production URL.
# NEXT_PUBLIC_SITE_URL=https://daehanlim.com
