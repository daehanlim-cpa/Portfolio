# Environment Variables Template

# --- Required: AI chat ---
# Google Gemini API key. See SETUP_API_KEY.md
GOOGLE_API_KEY=your_google_api_key_here

# --- Required in production: durable rate limiting ---
# Free tier at https://console.upstash.com (create a Redis database, copy the
# REST credentials). Without these the app falls back to in-memory limits, which
# reset on every cold start and do NOT protect your API budget.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional tuning ---
# Hard site-wide daily ceiling on chat messages. Past this the chat shows an
# "at capacity" state instead of calling the API. Default: 500
# CHAT_DAILY_GLOBAL_LIMIT=500

# Minimum retrieval similarity for a question to count as on-topic (0-1).
# Lower = more permissive. Calibrated against the real corpus. Default: 0.60
# CHAT_TOPIC_THRESHOLD=0.60

# Model overrides (defaults shown)
# RESUME_EMBEDDING_MODEL=gemini-embedding-001
# RESUME_CHAT_MODEL=gemini-3.5-flash-lite

# Used for the API origin check. Set to your production URL.
# NEXT_PUBLIC_SITE_URL=https://daehanlim.com
